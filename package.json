{
  "name": "convert-to-it-desktop",
  "productName": "Convert to it",
  "version": "1.0.0",
  "description": "Offline desktop build of convert.to.it — universal, private, on-device file converter with \"Open with\" file associations and automatic updates",
  "main": "src/main.cjs",
  "desktopName": "com.p2r3.convert.desktop",
  "license": "GPL-2.0-or-later",
  "author": "Convert to it! desktop wrapper — bundles the offline web app of p2r3/convert (GPL-2.0)",
  "homepage": "https://p2r3.github.io/convert/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/REPO.git"
  },
  "scripts": {
    "start": "electron .",
    "assets": "node scripts/fetch-web-assets.cjs",
    "feed": "node scripts/configure-feed.cjs",
    "icons": "node scripts/make-icons.cjs",
    "dist": "npm run assets && electron-builder --publish never",
    "dist:win": "npm run assets && electron-builder --win --publish never",
    "dist:mac": "npm run assets && electron-builder --mac --publish never",
    "dist:linux": "npm run assets && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.p2r3.convert.desktop",
    "productName": "Convert to it",
    "executableName": "ConvertToIt",
    "copyright": "GPL-2.0 — based on convert.to.it (p2r3/convert)",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "web/**",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*.{md,ts,tsx,mjs,map}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "REPO",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Convert-to-it-Setup-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Convert to it!"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Convert-to-it-arm64.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "synopsis": "Truly universal, private, on-device file converter",
      "syncDesktopName": true,
      "artifactName": "Convert-to-it-x64.AppImage"
    },
    "fileAssociations": [
      {
        "ext": [
          "png", "apng", "jpg", "jpeg", "jpe", "jfif", "gif", "webp", "avif", "avifs", "bmp", "dib",
          "ico", "cur", "svg", "svgz", "tif", "tiff", "heic", "heif", "heics", "heifs", "psd", "psb",
          "xcf", "kra", "tga", "icb", "vda", "vst", "vtp", "exr", "hdr", "rgbe", "jxl", "jp2", "j2k",
          "jpf", "jpx", "jps", "jpo", "pns", "pnm", "pbm", "pgm", "ppm", "pam", "pcx", "xpm", "xbm",
          "wbmp", "dds", "sgi", "bw", "ras", "ff", "farbfeld", "qoi", "pict", "pct", "pic", "arw",
          "cr2", "cr3", "crw", "nef", "nrw", "orf", "rw2", "pef", "ptx", "dng", "erf", "kdc", "dcr",
          "mrw", "raf", "raw", "sr2", "srf", "x3f", "3fr", "fff", "iiq", "mef", "mos"
        ],
        "name": "Convert to it Image",
        "description": "Open with Convert to it! — universal offline file converter",
        "mimeType": "image/*",
        "role": "Editor"
      },
      {
        "ext": [
          "mp3", "mp2", "mpga", "wav", "wave", "flac", "oga", "ogg", "opus", "spx", "aac", "m4a",
          "m4b", "m4r", "wma", "aiff", "aif", "aifc", "alac", "ape", "wv", "wvc", "amr", "awb",
          "ac3", "eac3", "caf", "au", "snd", "mid", "midi", "kar", "rmi", "xm", "mod", "s3m", "it",
          "mptm", "mtm", "mt2", "669", "far", "okt", "stm", "ult", "m15", "dsm", "amf", "gdm",
          "imf", "med", "mdl", "mo3", "psm", "ptm", "umx", "dsf", "dff", "tta", "voc", "gsm", "ra",
          "ram", "mpc", "mpp", "cda", "8svx", "iff", "sph", "nist", "pvf", "sd2", "txw",
          "vox", "w64", "wve", "aa", "aax", "act", "aue", "dct", "dss", "dvf", "iklax", "ivs",
          "m4p", "mmf", "msv", "nmf", "ogx", "paf", "qcp", "sds", "vb", "vqf"
        ],
        "name": "Convert to it Audio",
        "description": "Open with Convert to it! — universal offline file converter",
        "mimeType": "audio/*",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4", "m4v", "mov", "qt", "mkv", "mk3d", "mka", "webm", "avi", "wmv", "asf", "mpg",
          "mpeg", "mpe", "mpv", "m1v", "m2v", "mp2v", "ts", "m2ts", "mts", "m2t", "tp", "trp",
