          "pkl", "feather", "arrow", "geojson", "kml", "kmz", "gpx", "toon"
        ],
        "name": "Convert to it Document",
        "description": "Open with Convert to it! — universal offline file converter",
        "mimeType": "text/*;application/pdf;application/epub+zip;application/json;application/x-sqlite3;application/vnd.ms-excel;application/vnd.ms-powerpoint;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;application/rtf;application/x-fictionbook+xml",
        "role": "Editor"
      },
      {
        "ext": [
          "zip", "zipx", "tar", "gtar", "gz", "gzip", "tgz", "taz", "bz2", "bzip2", "tbz", "tbz2",
          "xz", "lzma", "txz", "tlz", "zst", "zstd", "sz", "snappy", "br", "brotli", "lz", "lzip",
          "lz4", "lzo", "lzop", "7z", "rar", "rar5", "cab", "arj", "lha", "lzh", "lza", "ace",
          "cpio", "ar", "a", "deb", "udeb", "rpm", "pkg", "apk", "aab", "xapk", "ipa", "jar", "war",
          "ear", "sar", "iso", "img", "cdr", "nrg", "mdf", "mds", "cue", "cdi", "isz", "z", "tz",
