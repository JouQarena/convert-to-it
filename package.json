          "pcf", "psf", "psfu", "snf", "fnt", "fon", "pfr", "t42", "cff", "ufo", "glyphs", "sfd",
          "vfb", "etx", "chr",
          "obj", "mtl", "stl", "stla", "stlb", "3mf", "ply", "pcd", "xyz", "pts", "ptx", "asc",
          "fbx", "gltf", "glb", "vrm", "vrma", "dae", "zae", "3ds", "prj", "blend", "max", "ma",
          "mb", "usd", "usda", "usdc", "usdz", "vrml", "wrl", "wrz", "x3d", "x3dz", "x3db", "x3dv",
          "off", "noff", "coff", "lwo", "lw", "lws", "cob", "scn", "md2", "md3", "ms3d", "nff",
          "smf", "ter", "abc", "b3dm", "czml",
          "musicxml", "mxl", "mei", "abc2", "sib", "mus", "musx", "niff", "sco", "ly", "ily",
          "gtp", "gp", "gp3", "gp4", "gp5", "gpx", "ptb", "tef", "tg", "crd",
          "srt", "vtt", "ssa", "ass", "sub", "idx", "sup", "usf", "ttxt", "smi", "rt", "pjs",
          "mpl", "sbv", "lrc", "elrc", "qrc", "srv3", "ttml", "dfxp", "itt", "scc", "cap"
        ],
        "name": "Convert to it File",
        "description": "Open with Convert to it! — universal offline file converter",
        "mimeType": "font/*;model/*;audio/midi;application/x-subrip;text/vtt;text/x-ssa;application/vnd.recordare.musicxml+xml",
        "role": "Editor"
      }
    ]
  }
}
